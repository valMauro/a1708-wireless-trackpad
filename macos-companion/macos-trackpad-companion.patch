index 0000000..1f635de
--- /dev/null
+++ b/src/apple_accel.rs
@@ -0,0 +1,153 @@
+//! Curve di accelerazione di Apple per i trackpad, copiate dal trackpad
+//! integrato del MacBook (ioreg: `HIDAccelCurves` e `HIDScrollAccelCurves`
+//! di AppleMultitouchTrackpadHIDEventDriver, 17/11/2026).
+//!
+//! L'algoritmo e' quello "parametrico" di IOHIDFamily (IOHIPointing.cpp,
+//! `PACurvesSetupAccelParams` / `PACurvesGetAccelerationMultiplier`):
+//! - le curve sono indicizzate dal cursore "Velocita' di tracciamento"
+//!   (`com.apple.trackpad.scaling`, 0..3); tra due curve si interpola;
+//! - velocita' standardizzata s in pollici al secondo;
+//! - fino a TangentSpeedLinear: polinomio G1 s + G2 s^2 + G3 s^3 + G4 s^4;
+//!   poi la sua tangente fino a TangentSpeedParabolicRoot; poi una radice;
+//! - uscita: 96 punti per pollice di "velocita' accelerata".
+
+#[derive(Clone, Copy, Debug)]
+struct Curve {
+    index: f64,
+    g: [f64; 4],
+    t0: f64, // TangentSpeedLinear
+    t1: f64, // TangentSpeedParabolicRoot
+}
+
+const F: f64 = 65536.0;
+
+const fn c(index: f64, g1: f64, g2: f64, g3: f64, t0: f64, t1: f64) -> Curve {
+    Curve { index: index / F, g: [g1 / F, g2 / F, g3 / F, 0.0], t0: t0 / F, t1: t1 / F }
+}
+
+/// HIDAccelCurves del MacBook (puntatore).
+const POINTER: [Curve; 10] = [
+    c(0.0, 65536.0, 0.0, 0.0, 484966.0, 1376256.0),
+    c(8192.0, 64881.0, 32768.0, 5243.0, 478413.0, 1310720.0),
+    c(32768.0, 64225.0, 43254.0, 6554.0, 471859.0, 1245184.0),
+    c(45056.0, 62915.0, 54395.0, 7864.0, 465306.0, 1179648.0),
+    c(57344.0, 61604.0, 65536.0, 9830.0, 458752.0, 1114112.0),
+    c(65536.0, 60293.0, 75366.0, 11796.0, 458752.0, 1048576.0),
+    c(98304.0, 58327.0, 85197.0, 13763.0, 458752.0, 983040.0),
+    c(131072.0, 56361.0, 95027.0, 15729.0, 458752.0, 917504.0),
+    c(163840.0, 54395.0, 108790.0, 18350.0, 458752.0, 851968.0),
+    c(196608.0, 65536.0, 123208.0, 23593.0, 458752.0, 786432.0),
+];
+
+/// HIDScrollAccelCurves del MacBook (scorrimento).
+const SCROLL: [Curve; 10] = [
+    c(0.0, 65536.0, 0.0, 0.0, 393216.0, 786432.0),
+    c(8192.0, 62259.0, 39322.0, 0.0, 406323.0, 786432.0),
+    c(32768.0, 58982.0, 58982.0, 0.0, 419430.0, 786432.0),
+    c(45056.0, 55706.0, 78643.0, 0.0, 432538.0, 786432.0),
+    c(57344.0, 52429.0, 91750.0, 0.0, 445645.0, 786432.0),
+    c(65536.0, 49152.0, 104858.0, 0.0, 458752.0, 786432.0),
+    c(98304.0, 45875.0, 117965.0, 0.0, 471859.0, 786432.0),
+    c(131072.0, 42598.0, 131072.0, 0.0, 484966.0, 786432.0),
+    c(163840.0, 39322.0, 144179.0, 0.0, 498074.0, 786432.0),
+    c(196608.0, 36045.0, 157286.0, 0.0, 511181.0, 786432.0),
+];
+
+/// Curva per l'indice voluto, interpolata tra le due vicine (come Apple).
+fn interpolate(curves: &[Curve], desired: f64) -> Curve {
+    let desired = desired.clamp(curves[0].index, curves[curves.len() - 1].index);
+    for w in curves.windows(2) {
+        let (lo, hi) = (w[0], w[1]);
+        if desired <= hi.index {
+            if hi.index <= lo.index {
+                return hi;
+            }
+            let r = (desired - lo.index) / (hi.index - lo.index);
+            let mut out = hi;
+            out.index = desired;
+            for i in 0..4 {
+                out.g[i] = (lo.g[i] + (hi.g[i] - lo.g[i]) * r).max(0.0);
+            }
+            out.t0 = (lo.t0 + (hi.t0 - lo.t0) * r).max(0.0);
+            out.t1 = (lo.t1 + (hi.t1 - lo.t1) * r).max(0.0);
+            return out;
+        }
+    }
+    curves[curves.len() - 1]
+}
+
+fn q(c: &Curve, x: f64) -> f64 {
+    x * (c.g[0] + x * (c.g[1] + x * (c.g[2] + x * c.g[3])))
+}
+
+fn dq(c: &Curve, x: f64) -> f64 {
+    c.g[0] + x * (2.0 * c.g[1] + x * (3.0 * c.g[2] + x * 4.0 * c.g[3]))
+}
+
+/// Velocita' accelerata (pollici/s "virtuali") per una velocita' s in pollici/s.
+fn evaluate(c: &Curve, s: f64) -> f64 {
+    if s <= 0.0 {
+        return 0.0;
+    }
+    let first_tangent = c.t1 > 0.0 && c.t1 < c.t0;
+    let (m0, b0, y1) = if !first_tangent {
+        let y0 = q(c, c.t0);
+        let m0 = dq(c, c.t0);
+        let b0 = y0 - m0 * c.t0;
+        (m0, b0, m0 * c.t1 + b0)
+    } else {
+        (dq(c, c.t1), 0.0, q(c, c.t1))
+    };
+    let m_root = 2.0 * m0 * y1;
+    let b_root = y1 * y1 - m_root * c.t1;
+    let t_first = if first_tangent { c.t1 } else { c.t0 };
+    if t_first != 0.0 && s <= t_first {
+        q(c, s)
+    } else if !first_tangent && c.t1 != 0.0 && s <= c.t1 {
+        m0 * s + b0
+    } else {
+        (m_root * s + b_root).max(0.0).sqrt()
+    }
+}
+
+const MM_PER_INCH: f64 = 25.4;
+const POINTS_PER_INCH: f64 = 96.0;
+
+/// Puntatore: punti/secondo per una velocita' del dito in mm/s.
+/// `scaling` e' il valore di "Velocita' di tracciamento" (0..3).
+pub fn pointer_pts_per_sec(v_mm_per_sec: f64, scaling: f64) -> f64 {
+    let curve = interpolate(&POINTER, scaling);
+    POINTS_PER_INCH * evaluate(&curve, v_mm_per_sec.abs() / MM_PER_INCH)
+}
+
+/// Scorrimento: punti/secondo per una velocita' delle dita in mm/s.
+/// `scaling` e' la velocita' di scorrimento del trackpad (0..3).
+pub fn scroll_pts_per_sec(v_mm_per_sec: f64, scaling: f64) -> f64 {
+    let curve = interpolate(&SCROLL, scaling);
+    POINTS_PER_INCH * evaluate(&curve, v_mm_per_sec.abs() / MM_PER_INCH)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn continuous_and_increasing() {
+        for scaling in [0.0, 0.3125, 0.6875, 1.5, 3.0] {
+            let mut prev = 0.0;
+            let mut v = 0.5;
+            while v < 2000.0 {
+                let p = pointer_pts_per_sec(v, scaling);
+                assert!(p >= prev, "scaling {scaling} v {v}: {p} < {prev}");
+                prev = p;
+                v *= 1.05;
+            }
+        }
+    }
+
+    #[test]
+    fn slow_motion_is_about_96_points_per_inch() {
+        let gain = pointer_pts_per_sec(1.0, 0.6875) / 1.0; // pt per mm at 1 mm/s
+        assert!((gain - 96.0 / 25.4 * 0.96).abs() < 0.2, "{gain}");
+    }
+}
