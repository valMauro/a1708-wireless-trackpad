     /// own free-running scan_time counter, so each gets its own clock.
     scan_clock: ScanTimeClock,
     control_path: ControlPath,
+    /// Jitter buffer: frames are released at their scan-time rhythm,
+    /// delayed just enough to absorb delivery bursts (Bluetooth).
+    jitter: JitterBuffer,
