+/// macOS 27 DockSwipe: the Dock now reads an `IOHIDEvent` (type 23,
+/// DockSwipe) attached to the type-30 CGEvent instead of the private
+/// CGEvent gesture fields. Event layout follows Mac Mouse Fix's
+/// investigation (commit f92d2d53a) and OpenLogi's Apache-2.0 Rust port
+/// (`openlogi-inject/src/inject/macos/spaces.rs`, PR #1703): phase in the
+/// options word, motion / flavor / progress fields, and a Velocity child
+/// on the end phase. macOS 27 reads progress with the opposite sign when
+/// natural scrolling is on.
+mod dock_swipe_hid {
+    use objc2::msg_send;
+    use objc2::rc::{Allocated, Retained};
+    use objc2::runtime::{AnyClass, AnyObject};
+    use std::ffi::c_void;
+    use std::sync::OnceLock;
+
+    unsafe extern "C" {
+        pub fn CGEventSetType(event: *mut c_void, ty: u32);
+    }
+
+    const HID_TYPE_VELOCITY: u32 = 9;
+    const HID_TYPE_DOCK_SWIPE: u32 = 23;
+    const FIELD_MOTION: u32 = HID_TYPE_DOCK_SWIPE << 16 | 1;
+    const FIELD_PROGRESS: u32 = HID_TYPE_DOCK_SWIPE << 16 | 2;
+    const FIELD_FLAVOR: u32 = HID_TYPE_DOCK_SWIPE << 16 | 5;
+    const FIELD_VELOCITY_X: u32 = HID_TYPE_VELOCITY << 16;
+    const FIELD_VELOCITY_Y: u32 = HID_TYPE_VELOCITY << 16 | 1;
+    const FLAVOR_DOCK_PRIMARY: isize = 3;
+    const PHASE_SHIFT: u32 = 24;
+
+    type SetHidEvent = unsafe extern "C" fn(*mut c_void, *const c_void);
+
+    struct Api {
+        class: &'static AnyClass,
+        attach: SetHidEvent,
+    }
+
+    fn os_major() -> u32 {
+        let mut buf = [0u8; 32];
+        let mut len = buf.len();
+        let rc = unsafe {
+            libc::sysctlbyname(
+                c"kern.osproductversion".as_ptr(),
+                buf.as_mut_ptr() as *mut c_void,
+                &mut len,
+                std::ptr::null_mut(),
+                0,
+            )
+        };
+        if rc != 0 {
+            return 0;
+        }
+        let s = String::from_utf8_lossy(&buf[..len.saturating_sub(1)]).into_owned();
+        s.split('.').next().and_then(|m| m.trim_matches('\0').parse().ok()).unwrap_or(0)
+    }
+
+    fn api() -> Option<&'static Api> {
+        static API: OnceLock<Option<Api>> = OnceLock::new();
+        API.get_or_init(|| {
+            let major = os_major();
+            if major < 27 {
+                log::info!("DockSwipe: macOS {major}, using CGEvent fields");
+                return None;
+            }
+            unsafe {
+                libc::dlopen(c"/System/Library/Frameworks/IOKit.framework/IOKit".as_ptr(), libc::RTLD_LAZY);
+            }
+            let handle = unsafe {
+                libc::dlopen(
+                    c"/System/Library/PrivateFrameworks/SkyLight.framework/SkyLight".as_ptr(),
+                    libc::RTLD_LAZY,
+                )
+            };
+            if handle.is_null() {
+                log::warn!("DockSwipe: SkyLight not loadable; swipes will not animate");
+                return None;
+            }
+            let sym = unsafe { libc::dlsym(handle, c"SLEventSetIOHIDEvent".as_ptr()) };
+            if sym.is_null() {
+                log::warn!("DockSwipe: SLEventSetIOHIDEvent not found");
+                return None;
+            }
+            let Some(class) = AnyClass::get(c"HIDEvent") else {
+                log::warn!("DockSwipe: HIDEvent class not found");
+                return None;
+            };
+            log::info!("DockSwipe: macOS {major}, using attached IOHIDEvent");
+            let attach = unsafe { std::mem::transmute::<*mut c_void, SetHidEvent>(sym) };
+            Some(Api { class, attach })
+        })
+        .as_ref()
+    }
+
+    pub fn available() -> bool {
+        api().is_some()
+    }
+
+    fn new_event(class: &AnyClass, kind: u32) -> Option<Retained<AnyObject>> {
+        unsafe {
+            let this: Allocated<AnyObject> = msg_send![class, alloc];
+            msg_send![this, initWithType: kind, timestamp: 0_u64, senderID: 0_u64]
+        }
+    }
+
+    /// Build the DockSwipe IOHIDEvent and attach it to `event`.
+    /// `origin_offset` and `velocity` use the legacy field convention.
+    pub fn attach(event: *mut c_void, motion: i64, phase: i64, origin_offset: f64, velocity: Option<f64>) -> bool {
+        let Some(api) = api() else { return false };
+        // macOS 27 reads the horizontal sign reversed under natural
+        // scrolling; the vertical axis keeps the legacy sign (measured:
+        // flipping it put Mission Control on a downward swipe).
