+
+/// Adaptive de-jitter buffer. Each frame's excess delay (arrival minus
+/// the scan-clock-aligned time, i.e. how late it is versus the fastest
+/// delivery path) is recorded; the release delay is a high percentile of
+/// recent excess delays, so a USB link (≈0 ms excess) adds almost no
+/// latency while a bursty Bluetooth link is smoothed out.
+struct JitterBuffer {
+    queue: std::collections::VecDeque<(Frame, Timestamp)>,
+    excess_ms: std::collections::VecDeque<f64>,
+    delay_ms: f64,
+    last_due: Option<Timestamp>,
+    timer: Option<Timer>,
+    frames_since_update: u32,
+}
+
+impl JitterBuffer {
+    const SAMPLES: usize = 256;
+    const PERCENTILE: f64 = 0.90;
+    const MAX_DELAY_MS: f64 = 20.0;
+
+    fn new() -> Self {
+        Self {
+            queue: std::collections::VecDeque::new(),
+            excess_ms: std::collections::VecDeque::with_capacity(Self::SAMPLES),
+            delay_ms: 0.0,
+            last_due: None,
+            timer: None,
+            frames_since_update: 0,
+        }
+    }
+
+    fn record(&mut self, excess_ms: f64) {
+        if self.excess_ms.len() == Self::SAMPLES {
+            self.excess_ms.pop_front();
+        }
+        self.excess_ms.push_back(excess_ms);
+        self.frames_since_update += 1;
+        if self.frames_since_update >= 32 && self.excess_ms.len() >= 32 {
+            self.frames_since_update = 0;
+            let mut v: Vec<f64> = self.excess_ms.iter().copied().collect();
+            v.sort_by(|a, b| a.partial_cmp(b).unwrap());
+            let target = v[((v.len() - 1) as f64 * Self::PERCENTILE) as usize].min(Self::MAX_DELAY_MS);
+            // Move gently so the release rhythm doesn't jump.
+            let new = self.delay_ms + (target - self.delay_ms) * 0.25;
+            if (new - self.delay_ms).abs() >= 0.5 {
+                log::debug!("jitter buffer: delay {:.1} ms (p90 excess {:.1} ms)", new, target);
+            }
+            self.delay_ms = new;
+        }
+    }
+}
+
+/// Release every queued frame whose due time has come; re-arm the timer
+/// for the next one.
+fn jitter_drain(state: &mut DeviceState) {
+    let bridge = unsafe { &mut *state.bridge };
+    let now = Timestamp::now();
+    while let Some((_, due)) = state.jitter.queue.front() {
+        if *due > now + std::time::Duration::from_micros(300) {
+            break;
+        }
+        let (frame, due) = state.jitter.queue.pop_front().unwrap();
+        (bridge.on_frame)(frame, due);
+    }
+    if let Some((_, due)) = state.jitter.queue.front() {
+        let wait = due.saturating_duration_since(now).as_secs_f64();
+        let ptr = state as *mut DeviceState;
+        state.jitter.timer = Some(Timer::new(wait, 0.0, move || {
+            let state = unsafe { &mut *ptr };
+            jitter_drain(state);
+        }));
+    }
 }
 
