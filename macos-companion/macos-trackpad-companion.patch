+                let Some(child) = new_event(api.class, HID_TYPE_VELOCITY) else { return false };
+                // Points the way progress does.
+                let v = flip * -velocity.unwrap_or(0.0);
+                let _: () = msg_send![&*child, setDoubleValue: v, forField: FIELD_VELOCITY_X];
+                let _: () = msg_send![&*child, setDoubleValue: v, forField: FIELD_VELOCITY_Y];
+                let _: () = msg_send![&*hid, appendEvent: &*child];
+            }
+            (api.attach)(event, Retained::as_ptr(&hid).cast());
+        }
+        log::trace!("DockSwipe(HID) motion={motion} phase={phase} progress={progress:+.3}");
+        true
+    }
+}
+
