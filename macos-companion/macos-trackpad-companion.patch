+
+/// Natural scrolling (`com.apple.swipescrolldirection` in the global
+/// domain). Absent means on, the macOS default.
+pub fn natural_scrolling() -> bool {
+    let cf_key = CFString::new("com.apple.swipescrolldirection");
+    let value = unsafe {
+        CFPreferencesCopyAppValue(
+            cf_key.as_concrete_TypeRef(),
+            core_foundation_sys::preferences::kCFPreferencesAnyApplication,
+        )
+    };
+    if value.is_null() {
+        return true;
+    }
+    let on = unsafe {
+        if CFGetTypeID(value as CFTypeRef) == CFBooleanGetTypeID() {
+            CFBooleanGetValue(value as CFBooleanRef)
+        } else if CFGetTypeID(value as CFTypeRef) == CFNumberGetTypeID() {
+            let mut n: i32 = 1;
+            CFNumberGetValue(value as CFNumberRef, kCFNumberIntType, &mut n as *mut i32 as *mut std::ffi::c_void);
+            n != 0
+        } else {
+            true
+        }
+    };
+    unsafe { CFRelease(value as CFTypeRef) };
+    on
+}
+
+// ---------------------------------------------------------------------------
+// Impostazioni del trackpad del Mac, rilette al massimo ogni 2 secondi
+// (si leggono a ogni frame del trackpad).
+
+struct TrackpadPrefs {
+    letto: Option<std::time::Instant>,
+    scaling: f64,
+    scroll: f64,
+    taps: bool,
+}
+
+static TRACKPAD_PREFS: std::sync::Mutex<TrackpadPrefs> =
+    std::sync::Mutex::new(TrackpadPrefs { letto: None, scaling: 0.6875, scroll: 0.3125, taps: false });
+
+fn read_global_f64(key: &str) -> Option<f64> {
+    let cf_key = CFString::new(key);
+    let value = unsafe {
+        CFPreferencesCopyAppValue(
+            cf_key.as_concrete_TypeRef(),
+            core_foundation_sys::preferences::kCFPreferencesAnyApplication,
+        )
+    };
+    if value.is_null() {
+        return None;
+    }
+    let out = unsafe {
+        if CFGetTypeID(value as CFTypeRef) == CFNumberGetTypeID() {
+            let mut n: f64 = 0.0;
+            let ok = CFNumberGetValue(
+                value as CFNumberRef,
+                core_foundation_sys::number::kCFNumberDoubleType,
+                &mut n as *mut f64 as *mut std::ffi::c_void,
+            );
+            if ok && n.is_finite() { Some(n) } else { None }
+        } else {
+            None
+        }
+    };
+    unsafe { CFRelease(value as CFTypeRef) };
+    out
+}
+
+fn trackpad_prefs() -> (f64, f64, bool) {
+    let mut p = match TRACKPAD_PREFS.lock() {
+        Ok(p) => p,
+        Err(e) => e.into_inner(),
+    };
+    let scaduto = p.letto.map_or(true, |t| t.elapsed() >= std::time::Duration::from_secs(2));
+    if scaduto {
+        // Valori assenti = predefiniti di macOS (letti con ioreg sul MacBook:
+        // HIDPointerAcceleration 45056, HIDTrackpadScrollAcceleration 20480).
+        p.scaling = read_global_f64("com.apple.trackpad.scaling").unwrap_or(0.6875).clamp(0.0, 3.0);
+        p.scroll = read_global_f64("com.apple.trackpad.scrolling").unwrap_or(0.3125).clamp(0.0, 3.0);
+        p.taps = DOMAINS.iter().any(|domain| read_flag(domain, "Clicking"));
+        p.letto = Some(std::time::Instant::now());
+    }
+    (p.scaling, p.scroll, p.taps)
+}
+
+/// "Velocita' di tracciamento" del trackpad (0..3).
+pub fn trackpad_scaling() -> f64 {
+    trackpad_prefs().0
+}
+
+/// Velocita' di scorrimento del trackpad (0..3).
+pub fn trackpad_scroll_scaling() -> f64 {
+    trackpad_prefs().1
+}
+
+/// "Tocca per fare clic" attivo nelle Impostazioni di Sistema.
+pub fn tap_to_click() -> bool {
+    trackpad_prefs().2
+}
