+            let _: () = msg_send![&*hid, setOptions: (phase as u32) << PHASE_SHIFT];
+            let _: () = msg_send![&*hid, setIntegerValue: motion as isize, forField: FIELD_MOTION];
+            let _: () = msg_send![&*hid, setIntegerValue: FLAVOR_DOCK_PRIMARY, forField: FIELD_FLAVOR];
+            let _: () = msg_send![&*hid, setDoubleValue: progress, forField: FIELD_PROGRESS];
